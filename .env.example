# Supabase (Project Settings -> API). The service role key is used only on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string; signs the admin session cookie and salts visitor hashes
ADMIN_SECRET=

# Where the download buttons point. Leave empty to send people to the GitHub releases page.
DOWNLOAD_URL_WINDOWS=
DOWNLOAD_URL_MAC=
DOWNLOAD_URL_MAC_INTEL=

# Canonical URL for links, sitemap and social cards. On Vercel the production domain is used automatically.
NEXT_PUBLIC_SITE_URL=https://kiln-website-kohl.vercel.app
